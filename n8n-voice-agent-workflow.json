    {
      "parameters": {
        "jsCode": "let body = $input.item.json.body || $input.item.json || {};\n\nif (typeof body === 'string') {\n  try {\n    body = JSON.parse(body);\n  } catch (e) {}\n}\n\nlet toolCallId = '';\nlet args = {};\n\nif (body.message && body.message.toolCalls) {\n  // Vapi format\n  const message = body.message;\n  const toolCall = (message.toolCalls && message.toolCalls[0]) || {};\n  const func = toolCall.function || {};\n  toolCallId = toolCall.id || '';\n  args = func['arguments'] || {};\n} else if (body.call || body.args) {\n  // Retell full format\n  toolCallId = body.call?.call_id || '';\n  args = body.args || {};\n} else {\n  // Retell flat format (args only / root keys)\n  toolCallId = '';\n  args = body || {};\n}\n\nif (typeof args === 'string') {\n  try {\n    args = JSON.parse(args);\n  } catch (e) {}\n}\n\n\nconst rawName = args.clientName || '';\nconst safeName = rawName.replace(/'/g, \"''\");\nconst rawEmail = args.email || '';\nconst safeEmail = rawEmail.replace(/'/g, \"''\");\n\nreturn {\n  json: {\n    toolCallId,\n    clientName: safeName,\n    date: args.date || '',\n    time: args.time || '',\n    pax: args.pax || 0,\n    zone: args.zone || 'interior',\n    phone: args.phone ? String(args.phone).replace(/\\D/g, '') : '',\n    email: safeEmail\n  }\n};"
      },
